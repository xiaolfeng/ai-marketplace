        "workflow",
        "models"
      ],
      "skills": [
        "./skills"
      ]
    },
    {
      "name": "replay",
      "source": "./plugins/replay",
      "description": "复盘工作流：当 AI 在长对话或多轮自动执行中产出了大量动作而用户陷入信息过载时，逆向拆解「先看什么 → 为什么看 → 做了什么 → 引申到哪里」的因果链路，按读者与格式提供四个技能——自己看的大白话版 replay-md（Markdown 走读手册）与 replay-html（暖纸笔记本式步进页），对外发布的正式版 replay-post-md（Markdown 复盘报告）与 replay-post-html（翻页式正式报告）",
      "version": "0.1.0",
      "keywords": [
        "replay",
        "retrospective",
        "walkthrough",
        "postmortem",
        "session-review",
        "html",
        "markdown"
      ],
      "category": "developer-tools",
      "tags": [
        "replay",
        "retrospective",
        "walkthrough",
        "postmortem",
        "html",
        "markdown"
